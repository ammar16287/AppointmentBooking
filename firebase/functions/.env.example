# Copy this file to ".env" in the same folder and fill in what you use.
# Leave a provider blank to turn that channel off (push notifications always work).

# Email via SendGrid (https://sendgrid.com) — free tier is enough to start
SENDGRID_API_KEY=
EMAIL_FROM=bookings@yourdomain.com

# SMS via Twilio (https://twilio.com) or any provider with a similar REST API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
